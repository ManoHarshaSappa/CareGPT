# CareGPT Web - Environment Variables Template
# Author: Manohar Shasappa (sappamanoharsha@gmail.com)
# Copy this file to .env.local and fill in your actual values

# Database Configuration (NEON)
DATABASE_URL="postgresql://username:password@hostname:5432/database_name"

# AI Service Configuration
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
# Alternative: Claude API (if implementing Claude integration)
# ANTHROPIC_API_KEY="your-claude-api-key-here"

# Authentication (NextAuth.js)
NEXTAUTH_SECRET="your-secure-random-32-character-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CareGPT Web"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_AUTHOR_NAME="Manohar Shasappa"
NEXT_PUBLIC_AUTHOR_EMAIL="sappamanoharsha@gmail.com"

# Environment
NODE_ENV="development"

# Optional: Analytics and Monitoring
# VERCEL_ANALYTICS_ID="your-vercel-analytics-id"

# Optional: Rate Limiting
API_RATE_LIMIT_MAX_REQUESTS="100"
API_RATE_LIMIT_WINDOW_MS="900000"

# Optional: File Upload Limits
MAX_FILE_SIZE_MB="10"
ALLOWED_FILE_TYPES="application/json,application/xml,application/pdf"

# Optional: AI Configuration
AI_MODEL_PREFERENCE="gpt-4"
AI_TEMPERATURE="0.7"
AI_MAX_TOKENS="2048"

# Development Only
# NEXT_TELEMETRY_DISABLED="1"
# DISABLE_TYPESCRIPT_CHECK="true"